{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude/hooks/session-start.sh\" bindings"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude/hooks/session-start.sh\" policy 1"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude/hooks/session-start.sh\" policy 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude/hooks/check-attention.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__ccd_session__spawn_task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude/hooks/check-chip-brief.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude/hooks/check-coordinator-edit.py\""
          }
        ]
      }
    ]
  }
}
