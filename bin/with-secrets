#!/bin/sh
# Run a command with secrets from a template of op:// references
# (practices/secrets.md, "Secrets from a password manager"). Prints names only.
#
#   with-secrets [--operator] [--template FILE] [--project NAME] [--dry-run] -- CMD...
#
# Agent mode (default): the project's service-account token comes from the
# macOS Keychain item op-agent-<project>; no 1Password prompt. References must
# name an agents-* vault or give a vault ID. Default template: agent.env.tpl.
# --operator: the 1Password desktop app authorises (one prompt per run).
# Default template: operator.env.tpl.
set -eu

usage() {
  echo "usage: with-secrets [--operator] [--template FILE] [--project NAME] [--dry-run] -- CMD..." >&2
  exit 2
}
die() { echo "with-secrets: $*" >&2; exit 1; }

mode=agent template= project=${WITH_SECRETS_PROJECT:-} dry=0
while [ $# -gt 0 ]; do
  case $1 in
    --operator) mode=operator ;;
    --template) [ $# -ge 2 ] || usage; template=$2; shift ;;
    --project) [ $# -ge 2 ] || usage; project=$2; shift ;;
    --dry-run) dry=1 ;;
    --) shift; break ;;
    *) usage ;;
  esac
  shift
done
[ $# -gt 0 ] || [ "$dry" = 1 ] || usage

if [ -z "$template" ]; then
  if [ "$mode" = operator ]; then template=operator.env.tpl; else template=agent.env.tpl; fi
fi
[ -f "$template" ] || die "no template $template"

# Every line is blank, a comment, or NAME=op://VAULT/ITEM/FIELD[...]. A plain
# value is refused, so a template can't hold a secret by mistake.
vault_id='^[a-z0-9]\{26\}$'
lines=0
while IFS= read -r line || [ -n "$line" ]; do
  lines=$((lines + 1))
  case $line in
    ''|'#'*) continue ;;
    *=*) ;;
    *) die "$template:$lines: not NAME=op://... (line not shown)" ;;
  esac
  name=${line%%=*}
  ref=${line#*=}
  printf '%s\n' "$name" | grep -q '^[A-Za-z_][A-Za-z0-9_]*$' \
    || die "$template:$lines: not NAME=op://... (line not shown)"
  case $ref in
    op://*/*/*) ;;
    *) die "$template:$lines: $name is not an op:// reference" ;;
  esac
  vault=${ref#op://}; vault=${vault%%/*}
  if [ "$mode" = agent ]; then
    case $vault in
      agents-*) ;;
      *) printf '%s\n' "$vault" | grep -q "$vault_id" \
           || die "$template:$lines: $name uses vault $vault; agents use agents-* vaults only" ;;
    esac
  fi
  [ "$dry" = 1 ] && printf '%s\t%s\n' "$name" "$vault"
done < "$template"

if [ "$mode" = agent ] && [ -z "$project" ]; then
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not in a git repository; pass --project NAME"
  project=$(basename "$(dirname "$common")")
fi

# op run also resolves op:// values in the environment, which would bypass
# the template. Refuse them, by name.
stray=$(env | sed -n 's/^\([^=]*\)=op:\/\/.*/\1/p' | tr '\n' ' ')
[ -z "$stray" ] || die "environment holds op:// references (${stray% }); secrets come from the template only"

if [ "$dry" = 1 ]; then
  if [ "$mode" = agent ]; then
    echo "mode agent, project $project, template $template" >&2
  else
    echo "mode operator, template $template" >&2
  fi
  exit 0
fi

if [ "$mode" = operator ]; then
  unset OP_SERVICE_ACCOUNT_TOKEN
  exec op run --env-file "$template" -- "$@"
fi

token=$(security find-generic-password -s "op-agent-$project" -w 2>/dev/null) \
  || die "no Keychain item op-agent-$project; set it up as practices/secrets.md says"
[ -n "$token" ] || die "Keychain item op-agent-$project is empty"
# The token goes to op, not to the command's environment (hygiene for logs,
# not a boundary: the vault scope is the boundary).
OP_SERVICE_ACCOUNT_TOKEN=$token
export OP_SERVICE_ACCOUNT_TOKEN
exec op run --env-file "$template" -- \
  env -u OP_SERVICE_ACCOUNT_TOKEN "$@"
