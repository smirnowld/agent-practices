#!/bin/sh
# Run a command with secrets from a template of op:// references
# (practices/secrets.md, "Secrets from a password manager"). Prints names only.
#
#   with-secrets [--full-access] [--template FILE] [--project NAME] [--dry-run] -- CMD...
#
# Agent mode (default): the project's service-account token comes from the
# Keychain item op-agent-<project> on macOS, or from
# ~/.config/op/agent-<project>.token (mode 600, yours) on Linux; no 1Password
# prompt. References must name an agents-* vault or give a vault ID. Default
# template: agent.env.tpl.
# --full-access: the 1Password desktop app authorises with my own account, so it
# reaches every vault I can see (one prompt per run).
# Default template: full-access.env.tpl, else operator.env.tpl. --operator is the
# old name for --full-access, kept as an alias. In WSL with op.exe on PATH,
# full-access goes through the Windows op.exe and its 1Password app.
set -eu

usage() {
  echo "usage: with-secrets [--full-access] [--template FILE] [--project NAME] [--dry-run] -- CMD..." >&2
  exit 2
}
die() { echo "with-secrets: $*" >&2; exit 1; }
# GNU stat first, then BSD; the format gives owner, mode and identity.
# BSD %Mp%Lp keeps the setuid, setgid and sticky digit that GNU %a shows.
st() { stat -c "$1" -- "$3" 2>/dev/null || stat -f "$2" -- "$3" 2>/dev/null; }

mode=agent template= project=${WITH_SECRETS_PROJECT:-} dry=0
while [ $# -gt 0 ]; do
  case $1 in
    --full-access|--operator) mode=full-access ;;
    --template) [ $# -ge 2 ] || usage; template=$2; shift ;;
    --project) [ $# -ge 2 ] || usage; project=$2; shift ;;
    --dry-run) dry=1 ;;
    --) shift; break ;;
    *) usage ;;
  esac
  shift
done
[ $# -gt 0 ] || [ "$dry" = 1 ] || usage

if [ -z "$template" ]; then
  if [ "$mode" = full-access ]; then
    if [ -f full-access.env.tpl ]; then template=full-access.env.tpl
    elif [ -f operator.env.tpl ]; then template=operator.env.tpl
    else die "no template full-access.env.tpl (or operator.env.tpl)"
    fi
  else
    template=agent.env.tpl
  fi
fi
[ -f "$template" ] || die "no template $template"

# Every line is blank, a comment, or NAME=op://VAULT/ITEM/FIELD[...]. A plain
# value is refused, so a template can't hold a secret by mistake.
vault_id='^[a-z0-9]\{26\}$'
lines=0 names=
while IFS= read -r line || [ -n "$line" ]; do
  lines=$((lines + 1))
  case $line in
    ''|'#'*) continue ;;
    *=*) ;;
    *) die "$template:$lines: not NAME=op://... (line not shown)" ;;
  esac
  name=${line%%=*}
  ref=${line#*=}
  printf '%s\n' "$name" | grep -q '^[A-Za-z_][A-Za-z0-9_]*$' \
    || die "$template:$lines: not NAME=op://... (line not shown)"
  case $ref in
    op://*/*/*) ;;
    *) die "$template:$lines: $name is not an op:// reference" ;;
  esac
  names="$names $name"
  vault=${ref#op://}; vault=${vault%%/*}
  if [ "$mode" = agent ]; then
    case $vault in
      agents-*) ;;
      *) printf '%s\n' "$vault" | grep -q "$vault_id" \
           || die "$template:$lines: $name uses vault $vault; agents use agents-* vaults only" ;;
    esac
  fi
  [ "$dry" = 1 ] && printf '%s\t%s\n' "$name" "$vault"
done < "$template"

if [ "$mode" = agent ] && [ -z "$project" ]; then
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not in a git repository; pass --project NAME"
  project=$(basename "$(dirname "$common")")
fi

# op run also resolves op:// values in the environment, which would bypass
# the template. Refuse them, by name.
stray=$(env | sed -n 's/^\([^=]*\)=op:\/\/.*/\1/p' | tr '\n' ' ')
[ -z "$stray" ] || die "environment holds op:// references (${stray% }); secrets come from the template only"

wsl=0
if [ "$mode" = full-access ] && [ -n "${WSL_DISTRO_NAME:-}" ] \
  && command -v op.exe >/dev/null 2>&1; then
  wsl=1
fi

upper() { LC_ALL=C tr '[:lower:]' '[:upper:]'; }
if [ "$wsl" = 1 ]; then
  # Windows variable names ignore case: template names that differ only in
  # case, or that match PATH or WSLENV, would collide there.
  tnames=$(for n in $names; do printf '%s\n' "$n"; done | sort -u | upper)
  dup=$(printf '%s\n' "$tnames" | sort | uniq -d | tr '\n' ' ')
  [ -z "$dup" ] || die "template names differ only in case (${dup% }); Windows would merge them"
  for n in PATH WSLENV; do
    if printf '%s\n' "$tnames" | grep -qx "$n"; then
      die "template name $n (in any case) is not allowed in WSL"
    fi
  done
fi

if [ "$dry" = 1 ]; then
  if [ "$mode" = agent ]; then
    echo "mode agent, project $project, template $template" >&2
  elif [ "$wsl" = 1 ]; then
    echo "mode full-access (Windows op.exe), template $template" >&2
  else
    echo "mode full-access, template $template" >&2
  fi
  exit 0
fi

if [ "$mode" = full-access ]; then
  unset OP_SERVICE_ACCOUNT_TOKEN
  [ "$wsl" = 1 ] || exec op run --env-file "$template" -- "$@"

  # WSL: the Windows op.exe resolves the template and starts the command back
  # in this distro with wsl.exe.
  distro=$WSL_DISTRO_NAME
  opexe=$(command -v op.exe)
  wsllin=$(command -v wsl.exe) || die "no wsl.exe on PATH"
  cmdexe=$(command -v cmd.exe) || die "no cmd.exe on PATH; cannot check the Windows environment"
  user=$(id -un) && [ -n "$user" ] || die "cannot tell your user name"
  [ -n "${PWD:-}" ] && [ -d "$PWD" ] || die "cannot tell the current directory"
  # The caller's environment is written to a file below; it may hold secrets,
  # so it goes only in your runtime directory, never /tmp, and only when no
  # one else can replace the file there (WSLg without systemd sets a shared
  # 0777 directory).
  rt=${XDG_RUNTIME_DIR:-}
  while [ "$rt" != / ] && [ "${rt%/}" != "$rt" ]; do rt=${rt%/}; done
  badrt() { die "XDG_RUNTIME_DIR $rt $*; full-access in WSL needs a runtime directory only you can write to"; }
  [ -n "$rt" ] || die "XDG_RUNTIME_DIR is unset; full-access in WSL needs it"
  [ ! -L "$rt" ] || badrt "is a symlink"
  [ -d "$rt" ] || badrt "is not a directory"
  rst=$(st '%u %a' '%u %Mp%Lp' "$rt") || badrt "cannot be inspected"
  rowner=${rst%% *} rmode=${rst#* }
  case $rowner in ''|*[!0-9]*) badrt "has an unreadable owner" ;; esac
  case $rmode in ''|*[!0-7]*) badrt "has an unreadable mode" ;; esac
  [ "$rowner" = "$(id -u)" ] || badrt "is not owned by you"
  rlast=00$rmode; rlast=${rlast#"${rlast%??}"}
  case $rlast in
    *[2367]*) badrt "has mode $rmode; group and others must not write to it" ;;
  esac
  # Absolute, so a template named -x is not read as an option.
  case $template in /*) tabs=$template ;; *) tabs=$PWD/$template ;; esac
  wintpl=$(wslpath -w "$tabs") && [ -n "$wintpl" ] \
    || die "wslpath cannot convert $template to a Windows path"
  wslexe=$(wslpath -w "$wsllin") && [ -n "$wslexe" ] \
    || die "wslpath cannot convert $wsllin to a Windows path"

  # op.exe also resolves op:// values and service tokens in its own Windows
  # environment. Read that environment (without the template names crossing
  # from here) and refuse those, by name; values are never shown. Its stdin
  # is /dev/null: interop would hand it, and lose, the command's input.
  winenv=$( (set -- "$cmdexe"; for n in $names; do unset "$n"; done
    exec "$1" /d /c set) </dev/null 2>/dev/null) \
    || die "cannot read the Windows environment with cmd.exe"
  winenv=$(printf '%s\n' "$winenv" | tr -d '\r')
  winop=$(printf '%s\n' "$winenv" | sed -n 's/^\([^=][^=]*\)=op:\/\/.*/\1/p' | tr '\n' ' ')
  [ -z "$winop" ] || die "the Windows environment holds op:// references (${winop% }); secrets come from the template only"
  winnames=$(printf '%s\n' "$winenv" | sed -n 's/^\([^=][^=]*\)=.*/\1/p' | upper)
  wintok=$(printf '%s\n' "$winnames" | grep -x -e OP_SERVICE_ACCOUNT_TOKEN -e 'OP_CONNECT_.*' | tr '\n' ' ')
  [ -z "$wintok" ] || die "the Windows environment sets ${wintok% }; unset it there for full-access"
  clash=
  for n in $names; do
    u=$(printf '%s\n' "$n" | upper)
    if printf '%s\n' "$winnames" | grep -Fxq -- "$u"; then clash="$clash $n"; fi
  done
  [ -z "$clash" ] || die "template names match Windows variables, ignoring case:$clash"

  # Only variables WSLENV names cross from Windows back into WSL. For a name
  # listed twice the last entry wins, so entries for template names are
  # dropped and each name is appended plain (values are not paths).
  wslenv=
  set -f; old_ifs=$IFS; IFS=:
  for e in ${WSLENV:-}; do
    [ -n "$e" ] || continue
    u=$(printf '%s\n' "${e%%/*}" | upper)
    if printf '%s\n' "$tnames" | grep -Fxq -- "$u"; then continue; fi
    wslenv=${wslenv:+$wslenv:}$e
  done
  IFS=$old_ifs; set +f
  for n in $names; do
    case ":$wslenv:" in *":$n:"*) continue ;; esac
    wslenv=${wslenv:+$wslenv:}$n
  done

  # The new WSL session gets only what WSLENV names and the distro's PATH, so
  # the caller's environment goes in a file (mode 600, in your runtime
  # directory) that the command's shell sources and deletes. Template names
  # are left out so the secrets win; WSLENV in it is the caller's own, and
  # WSL_INTEROP, PWD and OLDPWD belong to the new session.
  dump= child=
  trap '[ -z "$dump" ] || rm -f -- "$dump"' EXIT
  # A signal here goes on to op.exe; once it has ended, the file is removed
  # and the exit status says which signal.
  fwd() {
    [ -z "$child" ] || { kill -s "$1" "$child" 2>/dev/null || :; wait "$child" 2>/dev/null || :; }
    exit "$2"
  }
  trap 'fwd HUP 129' HUP; trap 'fwd INT 130' INT; trap 'fwd TERM 143' TERM
  dump=$(mktemp "$rt/with-secrets.XXXXXX") || die "cannot create a file in $rt"
  (for n in $names; do unset "$n"; done; unset WSL_INTEROP PWD OLDPWD; export -p) > "$dump" \
    || die "cannot write the environment file"

  # --exec, not --: wsl.exe -- hands the command line to a shell, which breaks
  # quoting; --exec passes each argument verbatim. -u keeps you the user. The
  # inner shell enters the directory itself, since wsl.exe --cd falls back to
  # / when it is missing. op.exe runs in the background so the file is
  # removed after and signals can be passed on; its stdin is ours, not the
  # /dev/null a background job gets, and env --default-signal (where there)
  # undoes the ignored SIGINT and SIGQUIT a background job starts with.
  dflt=
  if env --default-signal=INT,QUIT true >/dev/null 2>&1; then dflt=--default-signal=INT,QUIT; fi
  # A closed stdin becomes /dev/null, so it can be handed on.
  if ! true 2>/dev/null 9<&0; then exec </dev/null; fi
  exec 3<&0
  (WSLENV=$wslenv; export WSLENV
   set -- "$opexe" run --env-file "$wintpl" -- \
     "$wslexe" -d "$distro" -u "$user" --cd "$PWD" --exec /bin/sh -c \
     '[ -n "$2" ] && cd -- "$2" || exit 126; unset WSLENV; . "$1" || exit 126; rm -f -- "$1"; shift 2; exec "$@"' \
     with-secrets "$dump" "$PWD" "$@"
   [ -z "$dflt" ] || set -- env "$dflt" "$@"
   for n in $names; do unset "$n"; done
   exec "$@") 0<&3 3<&- &
  child=$!
  exec 3<&-
  rc=0
  wait "$child" || rc=$?
  exit "$rc"
fi

case $(uname -s) in
  Darwin)
    token=$(security find-generic-password -s "op-agent-$project" -w 2>/dev/null) \
      || die "no Keychain item op-agent-$project; set it up as practices/secrets.md says"
    [ -n "$token" ] || die "Keychain item op-agent-$project is empty"
    ;;
  Linux)
    # The project name becomes part of a path: no '/', no leading '.' or '-'.
    # The name is not echoed: it may hold control characters.
    alnum=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
    case $project in
      ''|[!$alnum]*|*[!$alnum._-]*)
        die "the project name must match [A-Za-z0-9][A-Za-z0-9._-]* (pass --project NAME)" ;;
    esac
    d="${HOME:?HOME is not set}/.config/op"
    f="$d/agent-$project.token"
    bad() { die "token file $f $*; see practices/secrets.md, \"Token on Linux\""; }
    baddir() { die "token directory $d $*; see practices/secrets.md, \"Token on Linux\""; }
    # Never follow a link, for the directory or the file.
    [ ! -L "$d" ] || baddir "is a symlink"
    [ ! -L "$f" ] || bad "is a symlink"
    [ -e "$f" ] || bad "is missing"
    # Only you may replace the file: the directory is yours and not writable
    # by group or others.
    dst=$(st '%u %a' '%u %Mp%Lp' "$d") || baddir "cannot be inspected"
    downer=${dst%% *} dmode=${dst#* }
    case $downer in ''|*[!0-9]*) baddir "has an unreadable owner" ;; esac
    case $dmode in ''|*[!0-7]*) baddir "has an unreadable mode" ;; esac
    [ "$downer" = "$(id -u)" ] || baddir "is not owned by you"
    dlast=00$dmode; dlast=${dlast#"${dlast%??}"}
    case $dlast in
      *[2367]*) baddir "has mode $dmode; group and others must not write to it" ;;
    esac
    # Checked before opening so a FIFO can't block the open.
    [ -f "$f" ] || bad "is not a regular file"
    # Open once; the checks below hold for this descriptor, and the token is
    # read from it. The path's owner and mode count only while the path still
    # names the opened file (same inode), so a file swapped in after the
    # checks is never read. /dev/fd/3 follows the descriptor (on Linux
    # through /proc/self/fd); its own mode is not used, since macOS reports
    # it masked by the open mode.
    { command exec 3< "$f"; } 2>/dev/null || bad "cannot be read"
    [ -f /dev/fd/3 ] || bad "is not a regular file"
    fst=$(st '%u %a %d:%i' '%u %Mp%Lp %i' "$f") || bad "cannot be inspected"
    fid=$(stat -L -c '%d:%i' /dev/fd/3 2>/dev/null || stat -L -f '%i' /dev/fd/3 2>/dev/null) \
      || bad "cannot be inspected"
    [ "${fst##* }" = "$fid" ] || bad "changed while it was checked"
    fst=${fst% *}
    fowner=${fst%% *} fmode=${fst#* }
    case $fowner in ''|*[!0-9]*) bad "has an unreadable owner" ;; esac
    case $fmode in ''|*[!0-7]*) bad "has an unreadable mode" ;; esac
    [ "$fowner" = "$(id -u)" ] || bad "is not owned by you"
    # Only owner read/write bits, no setuid, setgid or sticky: an octal
    # string match (GNU 600, BSD 0600), so no shell has to agree on how it
    # reads a leading 0 in arithmetic.
    case $fmode in
      [0246]00|0[0246]00|0|00) ;;
      *) bad "has mode $fmode; it must be 600 or 400" ;;
    esac
    token=$(cat <&3 2>/dev/null) || bad "cannot be read"
    # Closed so op and the command don't inherit it.
    exec 3<&-
    case $token in *[![:space:]]*) ;; *) bad "is empty" ;; esac
    cr=$(printf '\r')
    case $token in *"$cr"*) bad "contains a carriage return (CRLF line ending)" ;; esac
    ;;
  *) die "agent mode supports macOS (Keychain) and Linux (token file) only; see practices/secrets.md" ;;
esac
# The token goes to op, not to the command's environment (hygiene for logs,
# not a boundary: the vault scope is the boundary).
OP_SERVICE_ACCOUNT_TOKEN=$token
export OP_SERVICE_ACCOUNT_TOKEN
exec op run --env-file "$template" -- \
  env -u OP_SERVICE_ACCOUNT_TOKEN "$@"
