#!/bin/sh
# Run a command with secrets from a template of op:// references
# (practices/secrets.md, "Secrets from a password manager"). Prints names only.
#
#   with-secrets [--operator] [--template FILE] [--project NAME] [--dry-run] -- CMD...
#
# Agent mode (default): the project's service-account token comes from the
# Keychain item op-agent-<project> on macOS, or from
# ~/.config/op/agent-<project>.token (mode 600, yours) on Linux; no 1Password
# prompt. References must name an agents-* vault or give a vault ID. Default
# template: agent.env.tpl.
# --operator: the 1Password desktop app authorises (one prompt per run).
# Default template: operator.env.tpl.
set -eu

usage() {
  echo "usage: with-secrets [--operator] [--template FILE] [--project NAME] [--dry-run] -- CMD..." >&2
  exit 2
}
die() { echo "with-secrets: $*" >&2; exit 1; }

mode=agent template= project=${WITH_SECRETS_PROJECT:-} dry=0
while [ $# -gt 0 ]; do
  case $1 in
    --operator) mode=operator ;;
    --template) [ $# -ge 2 ] || usage; template=$2; shift ;;
    --project) [ $# -ge 2 ] || usage; project=$2; shift ;;
    --dry-run) dry=1 ;;
    --) shift; break ;;
    *) usage ;;
  esac
  shift
done
[ $# -gt 0 ] || [ "$dry" = 1 ] || usage

if [ -z "$template" ]; then
  if [ "$mode" = operator ]; then template=operator.env.tpl; else template=agent.env.tpl; fi
fi
[ -f "$template" ] || die "no template $template"

# Every line is blank, a comment, or NAME=op://VAULT/ITEM/FIELD[...]. A plain
# value is refused, so a template can't hold a secret by mistake.
vault_id='^[a-z0-9]\{26\}$'
lines=0
while IFS= read -r line || [ -n "$line" ]; do
  lines=$((lines + 1))
  case $line in
    ''|'#'*) continue ;;
    *=*) ;;
    *) die "$template:$lines: not NAME=op://... (line not shown)" ;;
  esac
  name=${line%%=*}
  ref=${line#*=}
  printf '%s\n' "$name" | grep -q '^[A-Za-z_][A-Za-z0-9_]*$' \
    || die "$template:$lines: not NAME=op://... (line not shown)"
  case $ref in
    op://*/*/*) ;;
    *) die "$template:$lines: $name is not an op:// reference" ;;
  esac
  vault=${ref#op://}; vault=${vault%%/*}
  if [ "$mode" = agent ]; then
    case $vault in
      agents-*) ;;
      *) printf '%s\n' "$vault" | grep -q "$vault_id" \
           || die "$template:$lines: $name uses vault $vault; agents use agents-* vaults only" ;;
    esac
  fi
  [ "$dry" = 1 ] && printf '%s\t%s\n' "$name" "$vault"
done < "$template"

if [ "$mode" = agent ] && [ -z "$project" ]; then
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not in a git repository; pass --project NAME"
  project=$(basename "$(dirname "$common")")
fi

# op run also resolves op:// values in the environment, which would bypass
# the template. Refuse them, by name.
stray=$(env | sed -n 's/^\([^=]*\)=op:\/\/.*/\1/p' | tr '\n' ' ')
[ -z "$stray" ] || die "environment holds op:// references (${stray% }); secrets come from the template only"

if [ "$dry" = 1 ]; then
  if [ "$mode" = agent ]; then
    echo "mode agent, project $project, template $template" >&2
  else
    echo "mode operator, template $template" >&2
  fi
  exit 0
fi

if [ "$mode" = operator ]; then
  unset OP_SERVICE_ACCOUNT_TOKEN
  exec op run --env-file "$template" -- "$@"
fi

case $(uname -s) in
  Darwin)
    token=$(security find-generic-password -s "op-agent-$project" -w 2>/dev/null) \
      || die "no Keychain item op-agent-$project; set it up as practices/secrets.md says"
    [ -n "$token" ] || die "Keychain item op-agent-$project is empty"
    ;;
  Linux)
    # The project name becomes part of a path: no '/', no leading '.' or '-'.
    # The name is not echoed: it may hold control characters.
    alnum=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
    case $project in
      ''|[!$alnum]*|*[!$alnum._-]*)
        die "the project name must match [A-Za-z0-9][A-Za-z0-9._-]* (pass --project NAME)" ;;
    esac
    d="${HOME:?HOME is not set}/.config/op"
    f="$d/agent-$project.token"
    bad() { die "token file $f $*; see practices/secrets.md, \"Token on Linux\""; }
    baddir() { die "token directory $d $*; see practices/secrets.md, \"Token on Linux\""; }
    # GNU stat first, then BSD; the format gives owner, mode and identity.
    # BSD %Mp%Lp keeps the setuid, setgid and sticky digit that GNU %a shows.
    st() { stat -c "$1" -- "$3" 2>/dev/null || stat -f "$2" -- "$3" 2>/dev/null; }
    # Never follow a link, for the directory or the file.
    [ ! -L "$d" ] || baddir "is a symlink"
    [ ! -L "$f" ] || bad "is a symlink"
    [ -e "$f" ] || bad "is missing"
    # Only you may replace the file: the directory is yours and not writable
    # by group or others.
    dst=$(st '%u %a' '%u %Mp%Lp' "$d") || baddir "cannot be inspected"
    downer=${dst%% *} dmode=${dst#* }
    case $downer in ''|*[!0-9]*) baddir "has an unreadable owner" ;; esac
    case $dmode in ''|*[!0-7]*) baddir "has an unreadable mode" ;; esac
    [ "$downer" = "$(id -u)" ] || baddir "is not owned by you"
    dlast=00$dmode; dlast=${dlast#"${dlast%??}"}
    case $dlast in
      *[2367]*) baddir "has mode $dmode; group and others must not write to it" ;;
    esac
    # Checked before opening so a FIFO can't block the open.
    [ -f "$f" ] || bad "is not a regular file"
    # Open once; the checks below hold for this descriptor, and the token is
    # read from it. The path's owner and mode count only while the path still
    # names the opened file (same inode), so a file swapped in after the
    # checks is never read. /dev/fd/3 follows the descriptor (on Linux
    # through /proc/self/fd); its own mode is not used, since macOS reports
    # it masked by the open mode.
    { command exec 3< "$f"; } 2>/dev/null || bad "cannot be read"
    [ -f /dev/fd/3 ] || bad "is not a regular file"
    fst=$(st '%u %a %d:%i' '%u %Mp%Lp %i' "$f") || bad "cannot be inspected"
    fid=$(stat -L -c '%d:%i' /dev/fd/3 2>/dev/null || stat -L -f '%i' /dev/fd/3 2>/dev/null) \
      || bad "cannot be inspected"
    [ "${fst##* }" = "$fid" ] || bad "changed while it was checked"
    fst=${fst% *}
    fowner=${fst%% *} fmode=${fst#* }
    case $fowner in ''|*[!0-9]*) bad "has an unreadable owner" ;; esac
    case $fmode in ''|*[!0-7]*) bad "has an unreadable mode" ;; esac
    [ "$fowner" = "$(id -u)" ] || bad "is not owned by you"
    # Only owner read/write bits, no setuid, setgid or sticky: an octal
    # string match (GNU 600, BSD 0600), so no shell has to agree on how it
    # reads a leading 0 in arithmetic.
    case $fmode in
      [0246]00|0[0246]00|0|00) ;;
      *) bad "has mode $fmode; it must be 600 or 400" ;;
    esac
    token=$(cat <&3 2>/dev/null) || bad "cannot be read"
    # Closed so op and the command don't inherit it.
    exec 3<&-
    case $token in *[![:space:]]*) ;; *) bad "is empty" ;; esac
    cr=$(printf '\r')
    case $token in *"$cr"*) bad "contains a carriage return (CRLF line ending)" ;; esac
    ;;
  *) die "agent mode supports macOS (Keychain) and Linux (token file) only; see practices/secrets.md" ;;
esac
# The token goes to op, not to the command's environment (hygiene for logs,
# not a boundary: the vault scope is the boundary).
OP_SERVICE_ACCOUNT_TOKEN=$token
export OP_SERVICE_ACCOUNT_TOKEN
exec op run --env-file "$template" -- \
  env -u OP_SERVICE_ACCOUNT_TOKEN "$@"
