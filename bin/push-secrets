#!/bin/sh
# Push secrets from 1Password to where services read them
# (practices/secrets.md, "Secrets from a password manager"). Mine only: the 1Password
# desktop app authorises. Values never reach argv or the screen.
#
#   push-secrets [--dry-run] [--only NAME] [--destination D] [--repo OWNER/REPO] MANIFEST
#
# Manifest lines, fields separated by tabs (item names may hold spaces);
# a line starting with '#' is a comment:
#   render-key  op://REF               key push-secrets uses for render-group lines
#   gh-env:ENV  NAME  op://REF         GitHub environment secret
#   gh-repo     NAME  op://REF         GitHub repository secret
#   render-group:ENVGROUPID  NAME  op://REF   Render environment-group variable
set -eu

usage() {
  echo "usage: push-secrets [--dry-run] [--only NAME] [--destination D] [--repo OWNER/REPO] MANIFEST" >&2
  exit 2
}
die() { echo "push-secrets: $*" >&2; exit 1; }

dry=0 only= dest_filter= repo=
while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) dry=1 ;;
    --only) [ $# -ge 2 ] || usage; only=$2; shift ;;
    --destination) [ $# -ge 2 ] || usage; dest_filter=$2; shift ;;
    --repo) [ $# -ge 2 ] || usage; repo=$2; shift ;;
    -*) usage ;;
    *) break ;;
  esac
  shift
done
[ $# -eq 1 ] || usage
manifest=$1
[ -f "$manifest" ] || die "no manifest $manifest"
unset OP_SERVICE_ACCOUNT_TOKEN

render_api=https://api.render.com/v1

# Reads REF into $value, keeping trailing newlines; fails on an empty value.
read_ref() {
  value=$(op read -n "$1" && printf x) || return 1
  value=${value%x}
  [ -n "$value" ]
}

tab=$(printf '\t')

# Pass "check" validates the whole manifest before anything is read or
# pushed; pass "push" (or the dry-run listing) acts on it.
run_pass() {
  pass=$1 render_key_ref= n=0
  while IFS= read -r line <&4 || [ -n "$line" ]; do
    n=$((n + 1))
    case $line in '#'*) continue ;; esac
    # shellcheck disable=SC2086 # split the line into fields on purpose
    set -f; old_ifs=$IFS; IFS=$tab; set -- $line; IFS=$old_ifs; set +f
    [ $# -gt 0 ] || continue
    where="$manifest:$n"
    if [ "$1" = render-key ]; then
      [ $# -eq 2 ] || die "$where: render-key takes one op:// reference"
      case $2 in op://*/*/*) ;; *) die "$where: render-key is not an op:// reference" ;; esac
      [ -z "$render_key_ref" ] || die "$where: a second render-key line"
      render_key_ref=$2
      continue
    fi
    [ $# -eq 3 ] || die "$where: expected DESTINATION<tab>NAME<tab>op://REF"
    dest=$1 name=$2 ref=$3
    printf '%s\n' "$name" | grep -q '^[A-Za-z_][A-Za-z0-9_]*$' || die "$where: bad name"
    case $ref in op://*/*/*) ;; *) die "$where: $name is not an op:// reference" ;; esac
    case $dest in
      gh-env:?*|gh-repo) ;;
      render-group:?*) [ -n "$render_key_ref" ] || die "$where: render-group needs a render-key line above it" ;;
      *) die "$where: unknown destination $dest" ;;
    esac
    [ "$pass" != check ] || continue
    [ -z "$only" ] || [ "$name" = "$only" ] || continue
    [ -z "$dest_filter" ] || [ "$dest" = "$dest_filter" ] || continue
    if [ "$pass" = list ]; then
      printf '%s\t%s\n' "$dest" "$name"
    else
      push_one
    fi
  done 4< "$manifest"
}

push_one() {
  read_ref "$ref" || die "$where: could not read $name from 1Password (or it is empty)"
  case $dest in
    gh-env:*)
      printf '%s' "$value" | gh secret set "$name" --env "${dest#gh-env:}" ${repo:+--repo "$repo"} >/dev/null \
        || die "$where: gh secret set $name failed" ;;
    gh-repo)
      printf '%s' "$value" | gh secret set "$name" ${repo:+--repo "$repo"} >/dev/null \
        || die "$where: gh secret set $name failed" ;;
    render-group:*)
      body=$(printf '%s' "$value" | jq -cRs '{value: .}') || die "$where: jq failed for $name"
      if [ -z "$render_key" ]; then
        read_ref "$render_key_ref" || die "$where: could not read the render-key from 1Password"
        render_key=$value
      fi
      # The key reaches curl through a pipe on fd 3 and the body on stdin:
      # never in argv, never in a here-document's temporary file.
      status=$(printf 'Authorization: Bearer %s\n' "$render_key" | {
        printf '%s' "$body" |
          curl -sS -X PUT -o /dev/null -w '%{http_code}' \
            -H @/dev/fd/3 -H 'Content-Type: application/json' --data-binary @- \
            "$render_api/env-groups/${dest#render-group:}/env-vars/$name"
      } 3<&0) || die "$where: request for $name failed"
      body=
      case $status in 2??) ;; *) die "$where: Render answered $status for $name" ;; esac ;;
  esac
  value=
  pushed=$((pushed + 1))
  echo "pushed $dest $name" >&2
}

run_pass check
if [ "$dry" = 1 ]; then
  run_pass list
  exit 0
fi
for tool in op gh curl jq; do
  command -v "$tool" >/dev/null || die "$tool is not installed"
done
render_key= pushed=0
run_pass push
echo "push-secrets: $pushed pushed" >&2
